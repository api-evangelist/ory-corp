{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ory Network Billing Projects API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a workspace's projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{project-slug}.projects.oryapis.com/workspaces/:workspace/projects",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List a workspace's projects"
        },
        {
          "info": {
            "name": "Create a project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{project-slug}.projects.oryapis.com/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a project"
        },
        {
          "info": {
            "name": "Get a project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a project"
        },
        {
          "info": {
            "name": "Replace a project's configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace a project's configuration"
        },
        {
          "info": {
            "name": "Patch a project's configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Patch a project's configuration"
        },
        {
          "info": {
            "name": "Delete a project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a project"
        }
      ]
    }
  ],
  "bundled": true
}