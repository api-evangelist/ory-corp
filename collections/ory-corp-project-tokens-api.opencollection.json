{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ory Network Billing Project Tokens API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List project API tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId/tokens",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List project API tokens"
        },
        {
          "info": {
            "name": "Create a project API token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId/tokens",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a project API token"
        },
        {
          "info": {
            "name": "Delete a project API token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{project-slug}.projects.oryapis.com/projects/:projectId/tokens/:tokenId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a project API token"
        }
      ]
    }
  ],
  "bundled": true
}